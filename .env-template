DATABASE_URL=mysql://<dbusername>:<dbpassword>@localhost:3306/<databasename>

# Optional: minimum log level (error, warn, info, verbose, debug, silly). Defaults to debug.
LOGGER_LEVEL=debug
# Optional: Seq server URL to also ship logs to Seq. Leave empty to log to console only.
LOGGER_SERVER_URL=
LOGGER_API_KEY=
# Optional: directory to also write a rolling logfile to (helios-api.log, max 20MB, 1 backup file).
# Must already exist - if it's missing or unset, file logging is skipped entirely.
LOGGER_FILE_DIR=
# Optional: minimum log level for the logfile. Defaults to LOGGER_LEVEL (or info) if not set.
LOGGER_FILE_LEVEL=
# Optional: comma-separated "Class.function" or "Class" entries to exclude from logging, on every
# transport. "Class" alone excludes every function of that class. A * matches any part of a class or
# function name, e.g. "*.GetObjects" (GetObjects of every class) or "Leden*" (LedenService, LedenController).
# Only applies to debug/verbose entries - error/warn/info are always logged regardless of this setting.
# E.g. IGNORE_LOGGING=CompetentiesService.GetObjects, ProgressieController.ProgressieBoom, *.GetObjects
IGNORE_LOGGING=

# Optional: tijdzone voor alle tijd functies van de applicatie (default Europe/Amsterdam)
TIMEZONE=

# Optional: LID_ID waarmee de cronjobs (DienstenScheduler, RoosterScheduler) hun wijzigingen in de audit trail vastleggen.
# Niet gezet: een beheerder met 'cronjob' in de naam, is die er niet dan een andere beheerder
CRONJOB_ACTOR_ID=

# Optional: aantal maanden dat oude diensten en rooster dagen bewaard blijven, oudere worden permanent verwijderd
# door de DienstenScheduler en RoosterScheduler (default 12)
MAANDEN_BEWAREN=

# Optional: scheduler die dagelijks de audit records ouder dan AUDIT_MAANDEN_BEWAREN permanent verwijdert (AuditScheduler)
# AUDIT_SCHEDULER=false schakelt de scheduler uit (default true)
AUDIT_SCHEDULER=
# Cron expressie (default '15 4 * * *'), in de tijdzone van TIMEZONE
AUDIT_CRON=
# Aantal maanden dat audit records bewaard blijven (default 6)
AUDIT_MAANDEN_BEWAREN=
# false = niet direct bij opstarten uitvoeren (default true)
AUDIT_RUN_ON_STARTUP=

# Optional: scheduler die dagelijks de aanwezige vliegtuigen ouder dan AANWEZIG_VLIEGTUIGEN_MAANDEN_BEWAREN permanent verwijdert (AanwezigVliegtuigenScheduler)
# AANWEZIG_VLIEGTUIGEN_SCHEDULER=false schakelt de scheduler uit (default true)
AANWEZIG_VLIEGTUIGEN_SCHEDULER=
# Cron expressie (default '45 4 * * *'), in de tijdzone van TIMEZONE
AANWEZIG_VLIEGTUIGEN_CRON=
# Aantal maanden dat aanwezige vliegtuigen bewaard blijven (default 6)
AANWEZIG_VLIEGTUIGEN_MAANDEN_BEWAREN=
# false = niet direct bij opstarten uitvoeren (default true)
AANWEZIG_VLIEGTUIGEN_RUN_ON_STARTUP=

# Optional: scheduler die dagelijks de aanwezige leden ouder dan AANWEZIG_LEDEN_MAANDEN_BEWAREN permanent verwijdert (AanwezigLedenScheduler)
# AANWEZIG_LEDEN_SCHEDULER=false schakelt de scheduler uit (default true)
AANWEZIG_LEDEN_SCHEDULER=
# Cron expressie (default '30 4 * * *'), in de tijdzone van TIMEZONE
AANWEZIG_LEDEN_CRON=
# Aantal maanden dat aanwezige leden bewaard blijven (default 6)
AANWEZIG_LEDEN_MAANDEN_BEWAREN=
# false = niet direct bij opstarten uitvoeren (default true)
AANWEZIG_LEDEN_RUN_ON_STARTUP=

# Optional: scheduler die dagelijks de diensten ouder dan MAANDEN_BEWAREN permanent verwijdert (DienstenScheduler)
# DIENSTEN_SCHEDULER=false schakelt de scheduler uit (default true)
DIENSTEN_SCHEDULER=
# Cron expressie (default '0 4 * * *', een uur voor de RoosterScheduler), in de tijdzone van TIMEZONE
DIENSTEN_CRON=
# false = niet direct bij opstarten uitvoeren (default true)
DIENSTEN_RUN_ON_STARTUP=

# Optional: scheduler die dagelijks de ontbrekende rooster dagen aanmaakt (RoosterScheduler)
# ROOSTER_SCHEDULER=false schakelt de scheduler uit (default true)
ROOSTER_SCHEDULER=
# Cron expressie (default '0 5 * * *'), in de tijdzone van TIMEZONE
ROOSTER_CRON=
# Aantal dagen vooruit waarvoor een rooster moet bestaan (default 730)
ROOSTER_DAGEN_VOORUIT=
# false = niet direct bij opstarten uitvoeren (default true)
ROOSTER_RUN_ON_STARTUP=

# Verplicht: geheimen voor de JWT tokens (lange willekeurige tekst). Zonder deze start Helios.js niet
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
# Optional: geldigheid van de tokens in milliseconden (default 3600000 = 1 uur, resp. 604800000 = 7 dagen)
JWT_ACCESS_TOKEN_EXPIRATION_MS=
JWT_REFRESH_TOKEN_EXPIRATION_MS=

# Optional: SQL queries van Prisma loggen (default false)
LOGGING_SQL=
# Optional: komma gescheiden service namen die niet in de audit trail komen, bv. LoginService, AuditService
LOGGING_EXCLUDE_AUDIT=

# Optional: map voor geuploade documenten en avatars (default /var/www/html/documenten en /var/www/html/avatars)
DOC_DIR=
AVATAR_DIR=

# Optional: DDWV seizoen als MM-DD, gebruikt door de RoosterScheduler (default 04-01 t/m 10-31)
DDWV_START=
DDWV_EIND=

# Optional: MQTT broker. Zonder MQTT_HOST staat MQTT uit: database wijzigingen worden dan niet op helios/events
# gepubliceerd en de leden sync (gezc/sync) en factuur berichten (gezc/helios) mislukken
MQTT_HOST=
# Poort van de broker (default 1883)
MQTT_PORT=
# Client ID bij de broker (default helios-js). Gebruik een ander ID dan de PHP versie als beide tegelijk verbinden,
# anders verbreekt de broker de verbinding van de ander
MQTT_CLIENT_ID=
# Gebruikersnaam en wachtwoord bij de broker. Zonder MQTT_USERNAME wordt anoniem verbonden (MQTT_PASSWORD wordt dan genegeerd)
MQTT_USERNAME=
MQTT_PASSWORD=

