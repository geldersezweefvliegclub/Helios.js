DATABASE_URL=mysql://<dbusername>:<dbpassword>@localhost:3306/<databasename>

# Optional: minimum log level (error, warn, info, verbose, debug, silly). Defaults to debug.
LOGGER_LEVEL=debug
# Optional: Seq server URL to also ship logs to Seq. Leave empty to log to console only.
LOGGER_SERVER_URL=
LOGGER_API_KEY=

TESTING_PHP_URL=<phpurl>
TESTING_PHP_USERNAME=<username>
TESTING_PHP_PASSWORD=<password>

TESTING_NESTJS_URL<nestjsurl>
TESTING_NESTJS_USERNAME=
TESTING_NESTJS_PASSWORD=