DATABASE_URL=mysql://<dbusername>:<dbpassword>@localhost:3306/<databasename>

# Optional: minimum log level (error, warn, info, verbose, debug, silly). Defaults to debug.
LOGGER_LEVEL=debug
# Optional: Seq server URL to also ship logs to Seq. Leave empty to log to console only.
LOGGER_SERVER_URL=
LOGGER_API_KEY=
# Optional: directory to also write a rolling logfile to (helios-api.log, max 20MB, 1 backup file).
# Must already exist - if it's missing or unset, file logging is skipped entirely.
LOGGER_FILE_DIR=
# Optional: minimum log level for the logfile. Defaults to LOGGER_LEVEL (or info) if not set.
LOGGER_FILE_LEVEL=
# Optional: comma-separated "Class.function" or "Class" entries to exclude from logging, on every
# transport. "Class" alone excludes every function of that class. Only applies to debug/verbose
# entries - error/warn/info are always logged regardless of this setting.
# E.g. IGNORE_LOGGING=CompetentiesService.GetObjects, ProgressieController.ProgressieBoom
IGNORE_LOGGING=

TESTING_PHP_URL=<phpurl>
TESTING_PHP_USERNAME=<username>
TESTING_PHP_PASSWORD=<password>

TESTING_NESTJS_URL<nestjsurl>
TESTING_NESTJS_USERNAME=
TESTING_NESTJS_PASSWORD=