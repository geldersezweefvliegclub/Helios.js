model OperTrack {
  ID                                              Int             @id @default(autoincrement()) @db.UnsignedMediumInt
  LID_ID                                          Int             @db.UnsignedMediumInt
  INSTRUCTEUR_ID                                  Int?            @db.UnsignedMediumInt
  TEKST                                           String?         @db.Text
  START_ID                                        Int?            @db.UnsignedMediumInt
  INGEVOERD                                       DateTime?       @default(now()) @db.DateTime(0)
  LINK_ID                                         Int?            @db.UnsignedMediumInt
  VERWIJDERD                                      Int             @default(0) @db.UnsignedTinyInt
  LAATSTE_AANPASSING                              DateTime        @default(now()) @db.Timestamp(0)
  ref_leden_oper_tracks_LID_IDToref_leden         RefLid          @relation("oper_tracks_LID_IDToref_leden", fields: [LID_ID], references: [ID], onUpdate: Restrict, map: "oper_tracks_ibfk_1")
  ref_leden_oper_tracks_INSTRUCTEUR_IDToref_leden RefLid?         @relation("oper_tracks_INSTRUCTEUR_IDToref_leden", fields: [INSTRUCTEUR_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_tracks_ibfk_2")
  oper_startlijst                                 OperStartlijst? @relation(fields: [START_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_tracks_ibfk_3")
  oper_tracks                                     OperTrack?      @relation("oper_tracksTooper_tracks", fields: [LINK_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_tracks_ibfk_4")
  other_oper_tracks                               OperTrack[]     @relation("oper_tracksTooper_tracks")

  @@index([INSTRUCTEUR_ID], map: "INSTRUCTEUR_ID")
  @@index([LID_ID], map: "LID_ID")
  @@index([LINK_ID], map: "LINK_ID")
  @@index([START_ID], map: "START_ID")
  @@index([VERWIJDERD], map: "VERWIJDERD")
  @@map("oper_tracks")
}
