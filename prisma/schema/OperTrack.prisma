model OperTrack {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Het unieke ID van een track
  ID                 Int       @id @default(autoincrement()) @db.UnsignedMediumInt
  /// @description Verwijzing naar het lid waarover de track gaat, link naar de leden tabel
  /// @DtoRelationIncludeId
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  LID_ID             Int       @db.UnsignedMediumInt
  /// @description Verwijzing naar de instructeur die de track heeft ingevoerd, link naar de leden tabel
  /// @DtoRelationIncludeId
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  INSTRUCTEUR_ID     Int?      @db.UnsignedMediumInt
  /// @description Omschrijving van de track
  /// @DtoUpdateOptional
  TEKST              String    @db.Text
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @DtoRelationIncludeId
  /// @description Verwijzing naar de startlijst waar deze track bij hoort
  START_ID           Int?      @db.UnsignedMediumInt
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Tijdstempel wanneer de track is ingevoerd
  INGEVOERD          DateTime? @default(now()) @db.DateTime(0)
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Is de track gemarkeerd als verwijderd
  VERWIJDERD         Boolean   @default(false)
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Tijdstempel met de laatste wijziging van het record
  LAATSTE_AANPASSING DateTime  @updatedAt

  Lid         RefLid          @relation("oper_tracks_LID_IDToref_leden", fields: [LID_ID], references: [ID], onUpdate: Restrict, map: "oper_tracks_ibfk_1")
  Instructeur RefLid?         @relation("oper_tracks_INSTRUCTEUR_IDToref_leden", fields: [INSTRUCTEUR_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_tracks_ibfk_2")
  Startlijst  OperStartlijst? @relation(fields: [START_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_tracks_ibfk_3")

  @@index([INSTRUCTEUR_ID], map: "INSTRUCTEUR_ID")
  @@index([LID_ID], map: "LID_ID")
  @@index([START_ID], map: "START_ID")
  @@index([VERWIJDERD], map: "VERWIJDERD")
  @@map("oper_tracks")
}
