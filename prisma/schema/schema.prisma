generator client {
  provider = "prisma-client-js"
}

generator nestjsDto {
  provider                        = "prisma-generator-nestjs-dto"
  output                          = "../../src/generated/nestjs-dto"
  classValidation                 = "true"
  createDtoPrefix                 = "Create"
  definiteAssignmentAssertion     = "false"
  dtoSuffix                       = "Dto"
  entityPrefix                    = ""
  entitySuffix                    = ""
  exportRelationModifierClasses   = "true"
  fileNamingStyle                 = "camel"
  flatResourceStructure           = "false"
  generateFileTypes               = "dto"
  noDependencies                  = "false"
  outputApiPropertyType           = "true"
  outputToNestJsResourceStructure = "false"
  outputType                      = "class"
  prettier                        = "true"
  reExport                        = "false"
  requiredResponseApiProperty     = "true"
  updateDtoPrefix                 = "Update"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Audit {
  ID                 Int      @id @default(autoincrement()) @db.UnsignedMediumInt
  DATUM              DateTime @db.Date
  LID_ID             Int      @db.UnsignedMediumInt
  TABEL              String?  @db.VarChar(25)
  TABEL_NAAM         String?  @db.VarChar(25)
  ACTIE              String?  @db.VarChar(15)
  OBJECT_ID          Int?     @db.UnsignedMediumInt
  VOOR               String?  @db.Text
  DATA               String?  @db.Text
  RESULTAAT          String?  @db.Text
  VERWIJDERD         Int      @default(0) @db.UnsignedTinyInt
  LAATSTE_AANPASSING DateTime @default(now()) @db.Timestamp(0)
  ref_leden          RefLid   @relation(fields: [LID_ID], references: [ID], onUpdate: Restrict, map: "audit_ibfk_1")

  @@index([LID_ID], map: "LID_ID")
  @@map("audit")
}

model Documenten {
  ID                 Int      @id @default(autoincrement()) @db.UnsignedMediumInt
  DATUM              DateTime @default(now()) @db.DateTime(0)
  VOLGORDE           Int?     @db.UnsignedTinyInt
  GROEP_ID           Int      @db.UnsignedMediumInt
  TEKST              String?  @db.VarChar(250)
  URL                String?  @db.VarChar(250)
  LID_ID             Int?     @db.UnsignedMediumInt
  LEGE_REGEL         Int      @default(0) @db.UnsignedTinyInt
  ONDERSTREEP        Int      @default(0) @db.UnsignedTinyInt
  BOVEN              Int      @default(0) @db.UnsignedTinyInt
  VERWIJDERD         Int      @default(0) @db.UnsignedTinyInt
  LAATSTE_AANPASSING DateTime @default(now()) @db.Timestamp(0)
  ref_types          RefType  @relation(fields: [GROEP_ID], references: [ID], onUpdate: Restrict, map: "documenten_ibfk_1")

  @@index([GROEP_ID], map: "GROEP_ID")
  @@index([VERWIJDERD], map: "VERWIJDERD")
  @@map("documenten")
}

