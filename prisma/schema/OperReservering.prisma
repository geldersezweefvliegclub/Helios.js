model OperReservering {
  ID                 Int          @id @default(autoincrement()) @db.UnsignedMediumInt
  DATUM              DateTime     @db.Date
  VLIEGTUIG_ID       Int          @db.UnsignedMediumInt
  LID_ID             Int          @db.UnsignedMediumInt
  INGEVOERD_ID       Int          @db.UnsignedMediumInt
  IS_GEBOEKT         Int          @default(0) @db.UnsignedTinyInt
  OPMERKINGEN        String?      @db.Text
  VERWIJDERD         Int          @default(0) @db.UnsignedTinyInt
  LAATSTE_AANPASSING DateTime     @default(now()) @db.Timestamp(0)
  ref_leden          RefLid       @relation(fields: [LID_ID], references: [ID], onUpdate: Restrict, map: "oper_reservering_ibfk_1")
  ref_vliegtuigen    RefVliegtuig @relation(fields: [VLIEGTUIG_ID], references: [ID], onUpdate: Restrict, map: "oper_reservering_ibfk_2")

  @@index([LID_ID], map: "LID_ID")
  @@index([VLIEGTUIG_ID], map: "VLIEGTUIG_ID")
  @@map("oper_reservering")
}
