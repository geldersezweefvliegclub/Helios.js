  @@index([CATEGORIE_ID], map: "CATEGORIE_ID")
  @@index([DATUM], map: "DATUM")
  @@index([MELDER_ID], map: "MELDER_ID")
  @@index([ROLLEND_ID], map: "ROLLEND_ID")
  @@index([STATUS_ID], map: "STATUS_ID")
  @@index([TECHNICUS_ID], map: "TECHNICUS_ID")
  @@index([VERWIJDERD], map: "VERWIJDERD")
