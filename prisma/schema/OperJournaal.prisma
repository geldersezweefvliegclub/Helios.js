  ref_vliegtuigen                                  RefVliegtuig? @relation(fields: [VLIEGTUIG_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_journaal_ibfk_4")
  ref_leden_oper_journaal_MELDER_IDToref_leden     RefLid?       @relation("oper_journaal_MELDER_IDToref_leden", fields: [MELDER_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_journaal_ibfk_5")
  ref_leden_oper_journaal_TECHNICUS_IDToref_leden  RefLid?       @relation("oper_journaal_TECHNICUS_IDToref_leden", fields: [TECHNICUS_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_journaal_ibfk_6")
