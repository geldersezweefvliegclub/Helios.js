model OperRooster {
  ID                 Int          @id @default(autoincrement()) @db.UnsignedMediumInt
  DATUM              DateTime     @db.Date
  DDWV               Int          @default(0) @db.UnsignedTinyInt
  CLUB_BEDRIJF       Int          @default(1) @db.UnsignedTinyInt
  WINTER_WERK        Boolean      @default(false)
  MIN_SLEEPSTART     Int          @default(3) @db.UnsignedTinyInt
  MIN_LIERSTART      Int          @default(10) @db.UnsignedTinyInt
  OPMERKINGEN        String?      @db.Text
  VERWIJDERD         Int          @default(0) @db.UnsignedTinyInt
  LAATSTE_AANPASSING DateTime     @default(now()) @db.Timestamp(0)
  oper_diensten      OperDienst[]

  @@index([DATUM], map: "DATUM")
  @@index([DDWV], map: "DDWV")
  @@index([VERWIJDERD], map: "VERWIJDERD")
  @@map("oper_rooster")
}
