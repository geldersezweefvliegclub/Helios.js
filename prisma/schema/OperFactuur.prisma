model OperFactuur {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Het unieke ID van een factuur
  ID                 Int      @id @default(autoincrement()) @db.UnsignedMediumInt
  /// @description Jaar van het lidmaatschap
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @minimum 2025
  JAAR               Int      @db.SmallInt
  /// @description Verwijzing naar het lid ID die de factuur ontvangt, link naar de leden tabel
  /// @DtoRelationIncludeId
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  LID_ID             Int?     @db.UnsignedMediumInt
  /// @DtoReadOnly
  /// @description De naam van het lid op het moment dat de factuur aangemaakt is.
  NAAM               String?  @db.VarChar(255)
  /// @description Het lidnummer zoals dat in de financiele administratie wordt gebruikt
  /// @maxLength 10
  LIDNR              String?  @db.VarChar(10)
  /// @description Het factuurnummer zoals dat door de boekhouding is toegekend
  /// @maxLength 10
  FACTUUR_NUMMER     String?  @db.VarChar(50)
  /// @description Lidmaatschapscode
  /// @maxLength 10
  CODE               String?  @db.VarChar(10)
  /// @description Omschrijving van de factuurregel
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  OMSCHRIJVING       String?  @db.VarChar(50)
  /// @description Bedrag wat gefactureerd is
  GEFACTUREERD       Decimal? @db.Decimal(50, 0)
  /// @DtoReadOnly
  /// @description Is het record gemarkeerd als verwijderd
  VERWIJDERD         Int      @default(0) @db.UnsignedTinyInt
  /// @DtoReadOnly
  /// @description Tijdstempel met de laatste wijziging van het record
  LAATSTE_AANPASSING DateTime @default(now()) @db.Timestamp(0)
  RefLid             RefLid?  @relation(fields: [LID_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_facturen_ibfk_1")

  @@index([LID_ID], map: "LID_ID")
  @@map("oper_facturen")
}
