model OperDienst {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Het unieke ID van de dienst
  ID                 Int         @id @default(autoincrement()) @db.UnsignedMediumInt
  /// @description Datum van de daginfo. Verplicht bij het aanmaken van een nieuwe dienst, optioneel bij het bijwerken van een bestaand record.
  /// @DtoUpdateOptional
  DATUM              DateTime    @db.Date
  /// @DtoRelationIncludeId
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Referentie naar het rooster
  ROOSTER_ID         Int         @db.UnsignedMediumInt
  /// @description Verwijzing naar het lid ID van diegene die ingeroosterd is, link naar de leden tabel
  /// @DtoRelationIncludeId
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  LID_ID             Int         @db.UnsignedMediumInt
  /// @description Referentie naar het type dienst (startleider, DDI, lierist, etc). Verplicht bij het aanmaken van een nieuwe dienst, optioneel bij het bijwerken van een bestaand record.
  /// @DtoRelationIncludeId
  /// @DtoCreateRequired
  /// @DtoUpdateOptional
  TYPE_DIENST_ID     Int?        @db.UnsignedMediumInt
  /// @description Verwijzing naar het lid ID van degene die de dienst heeft ingevoerd, link naar de leden tabel. Wordt bij het aanmaken altijd server-side gezet op de ingelogde gebruiker en kan niet door de client opgegeven of gewijzigd worden (alleen-lezen veld, niet aanwezig in de create/update request body).
  /// @DtoRelationIncludeId
  /// @DtoReadOnly
  INGEVOERD_DOOR_ID  Int?        @db.UnsignedMediumInt
  /// @description True als het lid aanwezig was tijdens deze dienst
  AANWEZIG           Boolean?
  /// @DtoReadOnly
  /// @description Is de DDWV dienst uitbetaald?
  UITBETAALD         Boolean     @default(false)
  /// @description True als het lid afwezig was tijdens deze dienst
  AFWEZIG            Boolean?
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Is het record gemarkeerd als verwijderd
  VERWIJDERD         Boolean     @default(false)
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  LAATSTE_AANPASSING DateTime    @updatedAt
  /// @DtoRelationCanConnectOnCreate
  /// @DtoReadOnly
  TypeDienst         RefType?    @relation(fields: [TYPE_DIENST_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_diensten_ibfk_1")
  /// @DtoRelationCanConnectOnCreate
  /// @DtoReadOnly
  RefLid             RefLid      @relation("oper_diensten_LID_IDToref_leden", fields: [LID_ID], references: [ID], onUpdate: Restrict, map: "oper_diensten_ibfk_2")
  /// @DtoRelationCanConnectOnCreate
  /// @DtoReadOnly
  RefIngevoerd       RefLid?     @relation("oper_diensten_INGEVOERD_DOOR_IDToref_leden", fields: [INGEVOERD_DOOR_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_diensten_ibfk_3")
  /// @DtoRelationCanConnectOnCreate
  /// @DtoReadOnly
  Rooster            OperRooster @relation(fields: [ROOSTER_ID], references: [ID], onUpdate: Restrict, map: "oper_diensten_ibfk_4")

  @@index([DATUM], map: "DATUM")
  @@index([INGEVOERD_DOOR_ID], map: "INGEVOERD_DOOR_ID")
  @@index([LID_ID], map: "LID_ID")
  @@index([ROOSTER_ID], map: "ROOSTER_ID")
  @@index([TYPE_DIENST_ID], map: "TYPE_DIENST_ID")
  @@index([VERWIJDERD], map: "VERWIJDERD")
  @@map("oper_diensten")
}
