model OperDienst {
  ID                                                   Int         @id @default(autoincrement()) @db.UnsignedMediumInt
  DATUM                                                DateTime    @db.Date
  ROOSTER_ID                                           Int         @db.UnsignedMediumInt
  LID_ID                                               Int         @db.UnsignedMediumInt
  TYPE_DIENST_ID                                       Int?        @db.UnsignedMediumInt
  INGEVOERD_DOOR_ID                                    Int?        @db.UnsignedMediumInt
  AANWEZIG                                             Int?        @db.UnsignedTinyInt
  UITBETAALD                                           Int         @default(0) @db.UnsignedTinyInt
  AFWEZIG                                              Int?        @db.UnsignedTinyInt
  VERWIJDERD                                           Int         @default(0) @db.UnsignedTinyInt
  LAATSTE_AANPASSING                                   DateTime    @default(now()) @db.Timestamp(0)
  ref_types                                            RefType?    @relation(fields: [TYPE_DIENST_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_diensten_ibfk_1")
  ref_leden_oper_diensten_LID_IDToref_leden            RefLid      @relation("oper_diensten_LID_IDToref_leden", fields: [LID_ID], references: [ID], onUpdate: Restrict, map: "oper_diensten_ibfk_2")
  ref_leden_oper_diensten_INGEVOERD_DOOR_IDToref_leden RefLid?     @relation("oper_diensten_INGEVOERD_DOOR_IDToref_leden", fields: [INGEVOERD_DOOR_ID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "oper_diensten_ibfk_3")
  oper_rooster                                         OperRooster @relation(fields: [ROOSTER_ID], references: [ID], onUpdate: Restrict, map: "oper_diensten_ibfk_4")

  @@index([DATUM], map: "DATUM")
  @@index([INGEVOERD_DOOR_ID], map: "INGEVOERD_DOOR_ID")
  @@index([LID_ID], map: "LID_ID")
  @@index([ROOSTER_ID], map: "ROOSTER_ID")
  @@index([TYPE_DIENST_ID], map: "TYPE_DIENST_ID")
  @@index([VERWIJDERD], map: "VERWIJDERD")
  @@map("oper_diensten")
}
