model OperDagRapport {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Het unieke ID van een dagrapport
  ID                 Int      @id @default(autoincrement()) @db.UnsignedMediumInt
  /// @description Datum van het dagrapport
  DATUM              DateTime @db.Date
  /// @description Referentie naar het vliegveld in de type tabel. Verplicht bij het aanmaken van een nieuw dagrapport, optioneel bij het bijwerken van een bestaand record.
  /// @DtoRelationIncludeId
  /// @DtoUpdateOptional
  VELD_ID            Int      @db.UnsignedMediumInt
  /// @description Verwijzing naar het lid ID van degene die het rapport heeft ingevoerd, link naar de leden tabel. Wordt bij het aanmaken altijd server-side gezet op de ingelogde gebruiker en kan niet door de client opgegeven of gewijzigd worden (alleen-lezen veld, niet aanwezig in de create/update request body).
  /// @DtoRelationIncludeId
  /// @DtoReadOnly
  INGEVOERD_ID       Int      @db.UnsignedMediumInt
  /// @description Beschrijving van de incidenten
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  INCIDENTEN         String?  @db.Text
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Beschrijving van het vliegbedrijf deze dag
  VLIEGBEDRIJF       String?  @db.Text
  /// @description Weersinformatie
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  METEO              String?  @db.Text
  /// @description Diegene die dienst hebben gedaan, startleider, DDI, lierist etc
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  DIENSTEN           String?  @db.Text
  /// @description Algemeen verslag van het vliegbedrijf
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  VERSLAG            String?  @db.Text
  /// @description Bijzonderheden over rollend materieel
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  ROLLENDMATERIEEL   String?  @db.Text
  /// @description Bijzonderheden over de ingezette vliegtuigen
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  VLIEGENDMATERIEEL  String?  @db.Text
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Is het record gemarkeerd als verwijderd
  VERWIJDERD         Boolean  @default(false)
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @description Tijdstempel met de laatste wijziging van het record
  LAATSTE_AANPASSING DateTime @updatedAt
  /// @DtoRelationCanConnectOnCreate
  /// @DtoReadOnly
  Veld               RefType  @relation(fields: [VELD_ID], references: [ID], onUpdate: Restrict, map: "oper_dagrapporten_ibfk_1")
  RefLid             RefLid   @relation(fields: [INGEVOERD_ID], references: [ID], onUpdate: Restrict, map: "oper_dagrapporten_ibfk_2")

  @@index([DATUM], map: "DATUM")
  @@index([INGEVOERD_ID], map: "INGEVOERD_ID")
  @@index([VELD_ID], map: "VELD_ID")
  @@index([VERWIJDERD], map: "VERWIJDERD")
  @@map("oper_dagrapporten")
}
